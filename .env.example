# Copy this file to .env.local for local development, and paste the same five
# values into Vercel > Project > Settings > Environment Variables for production.
# Never commit .env.local — it is already git-ignored.

# The /exec URL from your Google Apps Script Web App deployment.
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/XXXXXXXXXXXX/exec"

# Any long random string. Must match SHARED_SECRET at the top of scripts/apps-script.gs.
SHEETS_SHARED_SECRET="replace-with-a-long-random-string"

# From https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Who gets notified. Comma-separated for more than one inbox.
CONTACT_TO_EMAILS="you@example.com,dad@example.com"

# Use onboarding@resend.dev until you have verified your own domain in Resend,
# then switch to something like "Brown Brains <hello@yourdomain.com>".
CONTACT_FROM_EMAIL="Brown Brains <onboarding@resend.dev>"
